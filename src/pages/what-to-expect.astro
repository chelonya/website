---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Nav from '../components/Nav.astro';
import LogoNav from '../components/LogoNav.astro';
import Footer from '../components/Footer.astro';
import FooterMobile from '../components/FooterMobile.astro';
import HamMenu from '../components/HamMenu.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout 
  title="What to Expect"
  description="Prepare for your Costa Rica volunteer adventure. Learn about weather, currency, food, language, and what to bring for your sea turtle conservation experience."
  image="/bannerWTE.webp"
>
  <HamMenu />
  <Banner 
    bannerImg="/bannerWTE.webp" 
    bannerText="WHAT TO EXPECT" 
    subtitle="Everything you need to know before your volunteer adventure"
    ctaText="Ready to Join?"
    ctaLink={`${base}register`}
    textAlign="center" 
  />

  <!-- Essential Information Section -->
  <div class="max-w-7xl mx-auto px-4 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
      <!-- Weather Card -->
      <div class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-shadow duration-300">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-primary">Weather</h3>
        </div>
        <div class="text-gray-700 space-y-4 leading-relaxed">
          <p>
            You can expect a very hot and humid climate throughout the year in
            Costa Rica. The seasons are divided into the wet season (May to November) and the
            dry season (December to April). Turtle season is from June to November.
          </p>
          <div class="bg-primary/5 p-4 rounded-lg border-l-4 border-primary">
            <p class="font-semibold text-gray-800">💡 Pro Tip:</p>
            <p>Bring loose clothing, wear a hat, and remember to stay hydrated.</p>
          </div>
        </div>
      </div>

      <!-- Currency Card -->
      <div class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-shadow duration-300">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-primary">Currency</h3>
        </div>
        <div class="text-gray-700 leading-relaxed">
          <p class="mb-4">
            The currency used in Costa Rica is the <span class="font-semibold">Costa Rican colón</span>.
          </p>
          <div class="bg-gray-50 p-4 rounded-lg">
            <p class="text-lg font-semibold text-gray-800 mb-2">Exchange Rate:</p>
            <p class="text-2xl font-bold text-primary">$1 USD ≈ 500 colones</p>
          </div>
          <p class="mt-4 text-sm">
            * Check rates before coming to Costa Rica.
            Many restaurants and businesses in tourist areas accept US dollars and Credit Cards.
          </p>
        </div>
      </div>

      <!-- Food Card -->
      <div class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-shadow duration-300">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-primary">Food</h3>
        </div>
        <div class="text-gray-700 leading-relaxed">
          <p class="mb-4">
            We care about animals and the environment, which is why we support the local economy by purchasing locally produced ingredients.
          </p>
          <div class="bg-green-50 p-4 rounded-lg border-l-4 border-green-500">
            <p class="font-semibold text-green-800 mb-2">🌱 100% Vegetarian Diet</p>
            <p class="text-green-700">
              Our turtle camps serve exclusively vegetarian meals because we believe every action matters in building a better planet.
            </p>
          </div>
        </div>
      </div>

      <!-- Language Card -->
      <div class="bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-shadow duration-300">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-primary">Language</h3>
        </div>
        <div class="text-gray-700 leading-relaxed space-y-4">
          <p>
            The official language of Costa Rica is <span class="font-semibold">Spanish</span>. Although most young people speak some English, many places near our sites do not.
          </p>
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <p>
              Staff members at each site speak English, so Spanish is not required to volunteer.
            </p>
          </div>
          <p class="text-sm italic">
            However, we encourage learning some basic Spanish before you arrive!
          </p>
        </div>
      </div>
    </div>

    <!-- Packing List Section -->
    <div class="bg-gradient-to-br from-primary to-primary-dark rounded-3xl shadow-2xl p-10 md:p-12">
      <div class="text-center mb-12">
        <h3 class="text-4xl md:text-5xl font-bold text-white mb-4">What to Bring</h3>
        <p class="text-xl text-white/90">Essential items for your volunteer experience</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-4">
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 hover:bg-white/20 transition-all duration-300">
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-white text-lg">Sunscreen and sunglasses</span>
            </div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 hover:bg-white/20 transition-all duration-300">
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-white text-lg">Insect repellent (with DEET)</span>
            </div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 hover:bg-white/20 transition-all duration-300">
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-white text-lg">Open and closed-toed shoes</span>
            </div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 hover:bg-white/20 transition-all duration-300">
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-white text-lg">Rain clothes & swimsuit</span>
            </div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 hover:bg-white/20 transition-all duration-300">
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-white text-lg">Red light (required for turtle patrols)</span>
            </div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 hover:bg-white/20 transition-all duration-300">
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-white text-lg">Working clothes & dark clothes for patrols</span>
            </div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 hover:bg-white/20 transition-all duration-300">
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-white text-lg">Activities for free time (books, games, music)</span>
            </div>
          </div>
        </div>

        <div class="lg:order-first">
          <img
            class="w-full h-auto rounded-2xl shadow-2xl"
            alt="What to bring"
            src={`${base}whatsapp-image-20230921-at-1022-1@2x.png`}
          />
        </div>
      </div>
    </div>
  </div>

  <Footer />
  <FooterMobile />
  <LogoNav />
  <Nav />
</BaseLayout>
