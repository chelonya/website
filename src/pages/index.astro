---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Card from '../components/Card.astro';
import Nav from '../components/Nav.astro';
import LogoNav from '../components/LogoNav.astro';
import Footer from '../components/Footer.astro';
import FooterMobile from '../components/FooterMobile.astro';
import HamMenu from '../components/HamMenu.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout 
  title="Home"
  description="Join ASVPA's sea turtle conservation volunteer programs in Costa Rica. Protect endangered sea turtles on the Pacific and Caribbean coasts while making a real difference."
  image="/imgMatapalo.jpg"
>
  <HamMenu />
  <Banner
    bannerImg="/bannerHome.webp"
    bannerText="VOLUNTEERING A WORK OF HEART"
    subtitle="Join us in protecting sea turtles and preserving Costa Rica's coastlines"
    ctaText="Start Your Journey"
    ctaLink={`${base}register`}
    textAlign="center"
  />
  
  <!-- Welcome Section -->
  <div class="max-w-7xl mx-auto px-4 py-20">
    <!-- Main Heading -->
    <div class="text-center mb-16">
      <h2 class="text-5xl md:text-6xl font-bold text-primary mb-6">
        Welcome to ASVPA
      </h2>
      <p class="text-2xl text-gray-600 max-w-3xl mx-auto">
        Volunteer Association for Environmental Protection
      </p>
      <div class="w-24 h-1 bg-primary mx-auto mt-8"></div>
    </div>

    <!-- Mission Statement -->
    <div class="max-w-4xl mx-auto mb-20">
      <div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 border-t-4 border-primary">
        <h3 class="text-3xl font-bold text-primary mb-6 text-center">
          Volunteering Driven Ecological Conservation
        </h3>
        <p class="text-lg text-gray-700 leading-relaxed text-center">
          At ASVPA's project sites, volunteers from around the world come
          together to engage in ecological conservation alongside local
          biologists. We primarily deal with the protection of sea turtles but
          we also work to keep local beaches clean and provide aid for injured
          animals such as sloths.
        </p>
      </div>
    </div>

    <!-- Key Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div class="bg-white rounded-xl shadow-lg p-8 text-center hover:shadow-2xl transition-shadow duration-300">
        <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h4 class="text-xl font-bold text-gray-800 mb-3">Global Community</h4>
        <p class="text-gray-600">
          Join volunteers from around the world in meaningful conservation work
        </p>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-8 text-center hover:shadow-2xl transition-shadow duration-300">
        <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
        </div>
        <h4 class="text-xl font-bold text-gray-800 mb-3">Expert Guidance</h4>
        <p class="text-gray-600">
          Work alongside experienced local biologists and conservationists
        </p>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-8 text-center hover:shadow-2xl transition-shadow duration-300">
        <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
        </div>
        <h4 class="text-xl font-bold text-gray-800 mb-3">Make an Impact</h4>
        <p class="text-gray-600">
          Directly contribute to sea turtle conservation and environmental protection
        </p>
      </div>
    </div>
  </div>

  <!-- Projects Section -->
  <div class="bg-gradient-to-b from-gray-50 to-white py-20">
    <div class="max-w-7xl mx-auto px-4">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-5xl md:text-6xl font-bold text-primary mb-6">
          Our Projects
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-4">
          Discover our conservation sites on Costa Rica's stunning coastlines
        </p>
        <div class="w-24 h-1 bg-primary mx-auto mt-8"></div>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto mb-12">
        <div class="group">
          <Card
            title="Matapalo"
            imageUrl="/mtpPerfil.png"
            description="Pacific Coast, mostly olive ridley sea turtles."
            linkTo="/projects"
          />
          <div class="mt-6 px-4">
            <div class="flex items-center gap-2 text-gray-600 mb-2">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span class="font-semibold">Pacific Coast</span>
            </div>
            <p class="text-gray-700 leading-relaxed">
              Experience the vibrant Pacific coast while protecting olive ridley sea turtles. 
              This accessible site offers a perfect blend of conservation work and beach activities.
            </p>
          </div>
        </div>

        <div class="group">
          <Card
            title="Pacuare"
            imageUrl="/pacuarePerfil.jpg"
            description="Caribbean Coast, mostly leatherback turtles."
            linkTo="/projects"
          />
          <div class="mt-6 px-4">
            <div class="flex items-center gap-2 text-gray-600 mb-2">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span class="font-semibold">Caribbean Coast</span>
            </div>
            <p class="text-gray-700 leading-relaxed">
              Immerse yourself in the remote Caribbean wilderness while protecting endangered leatherback turtles. 
              A truly unique and rewarding conservation experience.
            </p>
          </div>
        </div>
      </div>

      <!-- CTA Button -->
      <div class="text-center">
        <a 
          href="/projects" 
          class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-secondary text-lg font-semibold rounded-full hover:bg-primary-dark transition-all hover:shadow-2xl hover:scale-105"
        >
          Explore All Projects
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <Footer />
  <FooterMobile />
  <LogoNav />
  <Nav />
</BaseLayout>
