---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Nav from '../components/Nav.astro';
import LogoNav from '../components/LogoNav.astro';
import Footer from '../components/Footer.astro';
import FooterMobile from '../components/FooterMobile.astro';
import HamMenu from '../components/HamMenu.astro';
---

<BaseLayout title="ASVPA - Register">
  <HamMenu />
  <Banner bannerImg="/bannerRegister.webp" bannerText="REGISTER" />

  <div class="max-w-7xl mx-auto px-4 py-16">
    <iframe 
      class="w-full h-[1200px] rounded-lg shadow-lg"
      src="https://docs.google.com/forms/d/e/1FAIpQLScev8I7FXIFIe99Q-1VDZoWpnX2Z83I975rKnVCOjgF2i-p3Q/viewform?embedded=true"
      title="Participation Form"
    ></iframe>
  </div>

  <Footer />
  <FooterMobile />
  <LogoNav />
  <Nav />
</BaseLayout>
