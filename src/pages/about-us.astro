---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Nav from '../components/Nav.astro';
import LogoNav from '../components/LogoNav.astro';
import Footer from '../components/Footer.astro';
import FooterMobile from '../components/FooterMobile.astro';
import HamMenu from '../components/HamMenu.astro';
---

<BaseLayout 
  title="About Us"
  description="Learn about ASVPA's mission to protect sea turtles and preserve Costa Rica's natural resources through volunteer-driven conservation, research, and education."
  image="/BannerAboutUs2.webp"
>
  <HamMenu />
  <Banner 
    bannerImg="/BannerAboutUs2.webp" 
    bannerText="ABOUT US" 
    subtitle="Dedicated to sea turtle conservation and environmental protection in Costa Rica"
    textAlign="center" 
  />

  <!-- Mission & Vision Section -->
  <div class="max-w-7xl mx-auto px-4 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-20">
      <div class="bg-white rounded-2xl shadow-xl p-10 border-l-8 border-primary hover:shadow-2xl transition-shadow duration-300">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-3xl font-bold text-primary">Our Mission</h3>
        </div>
        <p class="text-lg text-gray-700 leading-relaxed">
          ASVPA strives to aid in species and environmental conservation,
          engaging in research and education in Costa Rica, while working to
          preserve natural resources.
        </p>
      </div>

      <div class="bg-white rounded-2xl shadow-xl p-10 border-l-8 border-primary hover:shadow-2xl transition-shadow duration-300">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </div>
          <h3 class="text-3xl font-bold text-primary">Our Vision</h3>
        </div>
        <p class="text-lg text-gray-700 leading-relaxed">
          With the help of volunteers and community engagement, we can
          continue to protect the vulnerable sea turtle populations and
          other species living in the area. We have a competitive
          educational model of conservation, pursuing research and
          development projects with proactive, prospective, flexible and
          innovative character.
        </p>
      </div>
    </div>

    <!-- Impact Statistics -->
    <div class="bg-gradient-to-br from-primary to-primary-dark rounded-3xl shadow-2xl py-16 px-8 mb-20">
      <div class="text-center mb-12">
        <h3 class="text-4xl md:text-5xl font-bold text-white mb-4">Our Impact</h3>
        <p class="text-xl text-white/90">
          These numbers were made with your support
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 text-center hover:bg-white/20 transition-all duration-300">
          <div class="text-7xl font-bold text-white mb-4">93%</div>
          <div class="text-xl text-white/90 font-medium">
            Baby turtles made it to the sea
          </div>
        </div>

        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 text-center hover:bg-white/20 transition-all duration-300">
          <div class="text-7xl font-bold text-white mb-4">310</div>
          <div class="text-xl text-white/90 font-medium">
            Turtles seen on the beach
          </div>
        </div>

        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 text-center hover:bg-white/20 transition-all duration-300">
          <div class="text-7xl font-bold text-white mb-4">242</div>
          <div class="text-xl text-white/90 font-medium">
            Nests found and protected
          </div>
        </div>
      </div>
    </div>

    <!-- Volunteer Section -->
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h3 class="text-4xl md:text-5xl font-bold text-primary mb-6">
          Our Nature Needs Volunteers
        </h3>
        <div class="w-24 h-1 bg-primary mx-auto"></div>
      </div>

      <div class="bg-white rounded-2xl shadow-xl p-10 md:p-12">
        <h4 class="text-3xl font-bold text-gray-800 mb-6 text-center">
          What Does It Mean to Be a Volunteer?
        </h4>
        
        <div class="prose prose-lg max-w-none">
          <p class="text-lg text-gray-700 leading-relaxed mb-6">
            Voluntary refers to the subject who decides to provide a service
            or perform a job of his own free will, without being obliged to do
            so for legal, contractual, or economic reasons. In other words, a
            volunteer is a person who has the will to invest time and money to
            help a cause.
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
            <div class="flex gap-4">
              <div class="flex-shrink-0">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
              </div>
              <div>
                <p class="text-gray-700 leading-relaxed">
                  A volunteer looks for options and solutions in the face of adversity
                </p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex-shrink-0">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
              </div>
              <div>
                <p class="text-gray-700 leading-relaxed">
                  A volunteer supports the project to improve and grow
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />
  <FooterMobile />
  <LogoNav />
  <Nav />
</BaseLayout>
