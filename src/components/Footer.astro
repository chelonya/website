---
const base = import.meta.env.BASE_URL;
---

<footer class="hidden lg:block bg-primary text-gray-100">
  <div class="max-w-7xl mx-auto px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- About Section -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <img src={`${base}logoAsvpa.svg`} alt="ASVPA Logo" class="w-12 h-12" />
          <h3 class="text-2xl font-bold text-white">ASVPA</h3>
        </div>
        <p class="text-sm leading-relaxed mb-4">
          Volunteer Association for Environmental Protection. Dedicated to sea turtle conservation and environmental protection in Costa Rica.
        </p>
        <p class="text-xs italic text-gray-400">
          Protecting our oceans, one flipper at a time.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-bold text-white mb-6">Quick Links</h4>
        <ul class="space-y-3 text-sm">
          <li><a href={`${base}about-us`} class="hover:text-white transition-colors hover:translate-x-1 inline-block">About Us</a></li>
          <li><a href={`${base}projects`} class="hover:text-white transition-colors hover:translate-x-1 inline-block">Our Projects</a></li>
          <li><a href={`${base}services`} class="hover:text-white transition-colors hover:translate-x-1 inline-block">Volunteer Services</a></li>
          <li><a href={`${base}what-to-expect`} class="hover:text-white transition-colors hover:translate-x-1 inline-block">What to Expect</a></li>
          <li><a href={`${base}faq`} class="hover:text-white transition-colors hover:translate-x-1 inline-block">FAQ</a></li>
          <li><a href={`${base}register`} class="hover:text-white transition-colors hover:translate-x-1 inline-block font-semibold text-white">Register Now</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-lg font-bold text-white mb-6">Get in Touch</h4>
        <div class="space-y-4 text-sm">
          <a href="mailto:volunteercoordination@asvpa.org" class="flex items-start gap-3 group hover:text-white transition-colors">
            <img alt="Email" src={`${base}email3.svg`} class="w-5 h-5 mt-0.5 opacity-80 group-hover:opacity-100" />
            <div>
              <div class="font-semibold">Email</div>
              <div class="text-xs">volunteercoordination@asvpa.org</div>
            </div>
          </a>
          <a href="https://wa.me/50686161973" target="_blank" rel="noreferrer" class="flex items-start gap-3 group hover:text-white transition-colors">
            <img alt="WhatsApp" src={`${base}wa2.svg`} class="w-5 h-5 mt-0.5 opacity-80 group-hover:opacity-100" />
            <div>
              <div class="font-semibold">WhatsApp</div>
              <div class="text-xs">+506 86161973</div>
            </div>
          </a>
          <a href="https://ig.me/m/tortugasvpa" target="_blank" rel="noreferrer" class="flex items-start gap-3 group hover:text-white transition-colors">
            <img alt="Instagram" src={`${base}instagram.svg`} class="w-5 h-5 mt-0.5 opacity-80 group-hover:opacity-100" />
            <div>
              <div class="font-semibold">Instagram</div>
              <div class="text-xs">@tortugasvpa</div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-700 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-400">
      <div>
        © {new Date().getFullYear()} ASVPA. All rights reserved.
      </div>
      <div class="flex gap-6">
        <a href="https://www.termsfeed.com/live/763603f9-fbc4-400f-be26-bd561ae72d60" target="_blank" rel="noreferrer" class="hover:text-white transition-colors">
          Terms & Conditions
        </a>
        <span>|</span>
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
