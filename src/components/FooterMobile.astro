---
const base = import.meta.env.BASE_URL;
---

<footer class="lg:hidden bg-primary text-gray-100">
  <div class="px-6 py-12">
    <!-- Logo and Tagline -->
    <div class="text-center mb-8">
      <div class="flex items-center justify-center gap-3 mb-4">
        <img src={`${base}logoAsvpa.svg`} alt="ASVPA Logo" class="w-10 h-10" />
        <h3 class="text-xl font-bold text-white">ASVPA</h3>
      </div>
      <p class="text-xs italic text-gray-400">
        Protecting our oceans, one flipper at a time.
      </p>
    </div>

    <!-- Contact Icons -->
    <div class="flex justify-center gap-8 mb-8">
      <a href="mailto:volunteercoordination@asvpa.org" class="flex flex-col items-center gap-2 group">
        <div class="bg-slate-700 p-3 rounded-full group-hover:bg-slate-600 transition-colors">
          <img alt="Email" src={`${base}email3.svg`} class="w-6 h-6 opacity-80 group-hover:opacity-100" />
        </div>
        <span class="text-xs text-gray-400 group-hover:text-white transition-colors">Email</span>
      </a>

      <a href="https://wa.me/50686161973" target="_blank" rel="noreferrer" class="flex flex-col items-center gap-2 group">
        <div class="bg-slate-700 p-3 rounded-full group-hover:bg-slate-600 transition-colors">
          <img alt="WhatsApp" src={`${base}wa2.svg`} class="w-6 h-6 opacity-80 group-hover:opacity-100" />
        </div>
        <span class="text-xs text-gray-400 group-hover:text-white transition-colors">WhatsApp</span>
      </a>

      <a href="https://ig.me/m/tortugasvpa" target="_blank" rel="noreferrer" class="flex flex-col items-center gap-2 group">
        <div class="bg-slate-700 p-3 rounded-full group-hover:bg-slate-600 transition-colors">
          <img alt="Instagram" src={`${base}instagram.svg`} class="w-6 h-6 opacity-80 group-hover:opacity-100" />
        </div>
        <span class="text-xs text-gray-400 group-hover:text-white transition-colors">Instagram</span>
      </a>
    </div>

    <!-- Quick Links -->
    <div class="mb-8">
      <div class="grid grid-cols-2 gap-3 text-sm text-center">
        <a href={`${base}about-us`} class="hover:text-white transition-colors">About Us</a>
        <a href={`${base}projects`} class="hover:text-white transition-colors">Projects</a>
        <a href={`${base}services`} class="hover:text-white transition-colors">Services</a>
        <a href={`${base}what-to-expect`} class="hover:text-white transition-colors">What to Expect</a>
        <a href={`${base}faq`} class="hover:text-white transition-colors">FAQ</a>
        <a href={`${base}register`} class="col-span-2 text-white font-semibold">Register Now</a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-700 pt-6 text-center space-y-3">
      <div class="text-xs text-gray-400">
        © {new Date().getFullYear()} ASVPA. All rights reserved.
      </div>
      <div class="flex justify-center items-center gap-4 text-xs text-gray-400">
        <a href="https://www.termsfeed.com/live/763603f9-fbc4-400f-be26-bd561ae72d60" target="_blank" rel="noreferrer" class="hover:text-white transition-colors">
          Terms & Conditions
        </a>
        <span>|</span>
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
