---
interface Props {
  title: string;
  imageUrl: string;
  description: string;
  linkTo: string;
}

const { title, imageUrl, description, linkTo } = Astro.props;
---

<a href={linkTo} class="block group">
  <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300">
    <img src={imageUrl} alt={title} class="w-full h-64 object-cover" />
    <div class="p-6">
      <h2 class="text-2xl font-bold text-esmeralda mb-2 group-hover:text-teal-100 transition-colors">{title}</h2>
      <p class="text-gray-700">{description}</p>
    </div>
  </div>
</a>
