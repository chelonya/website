---
interface Props {
  bannerImg: string;
  bannerText: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  textAlign?: 'left' | 'center' | 'right';
}

const { bannerImg, bannerText, subtitle, ctaText, ctaLink, textAlign = 'center' } = Astro.props;
const base = import.meta.env.BASE_URL;
// Remove leading slash from bannerImg if present, then prepend base
const imagePath = bannerImg.startsWith('/') ? `${base}${bannerImg.slice(1)}` : `${base}${bannerImg}`;

const alignmentClasses = {
  left: 'text-left items-start justify-start',
  center: 'text-center items-center justify-center',
  right: 'text-right items-end justify-end'
};

const containerAlignmentClasses = {
  left: 'justify-start',
  center: 'justify-center',
  right: 'justify-end'
};

const textAlignClass = alignmentClasses[textAlign];
const containerAlignClass = containerAlignmentClasses[textAlign];
---

<div class={`relative w-full h-[500px] lg:h-[600px] flex items-center ${containerAlignClass} overflow-hidden`}>
  <!-- Background Image -->
  <div class="absolute inset-0">
    <img 
      src={imagePath} 
      alt="Banner" 
      class="w-full h-full object-cover"
    />
    <!-- Dark Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/50 to-black/60"></div>
  </div>
  
  <!-- Content -->
  <div class={`relative z-10 ${textAlignClass} px-8 lg:px-16 max-w-4xl`}>
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-wide drop-shadow-2xl">
      {bannerText}
    </h1>
    
    {subtitle && (
      <p class="text-lg md:text-xl lg:text-2xl text-white/90 mb-8 drop-shadow-lg">
        {subtitle}
      </p>
    )}
    
    {ctaText && ctaLink && (
      <a 
        href={ctaLink} 
        class="inline-block px-8 py-4 bg-primary text-secondary text-base md:text-lg font-semibold rounded-full hover:bg-primary-dark transition-all hover:shadow-2xl hover:scale-105"
      >
        {ctaText}
      </a>
    )}
  </div>
</div>
