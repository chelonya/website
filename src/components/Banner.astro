---
interface Props {
  bannerImg: string;
  bannerText: string;
}

const { bannerImg, bannerText } = Astro.props;
---

<div 
  class="relative w-full h-[400px] lg:h-[600px] bg-cover bg-center bg-no-repeat flex items-center justify-center"
  style={`background-image: url(${bannerImg})`}
>
  <div class="text-white text-3xl lg:text-5xl font-bold text-center px-4 drop-shadow-lg">
    {bannerText}
  </div>
</div>
