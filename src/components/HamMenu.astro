---
const base = import.meta.env.BASE_URL;
---

<div class="lg:hidden fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm shadow-md">
  <div class="flex justify-between items-center px-4 h-16">
    <!-- Logo -->
    <a href={`${base}`} class="flex items-center gap-2.5">
      <img class="w-10 h-10" alt="ASVPA Logo" src={`${base}logoAsvpa.svg`} />
      <div>
        <div class="text-base font-bold text-slate-800">ASVPA</div>
        <div class="text-[10px] text-gray-600">Sea Turtle Conservation</div>
      </div>
    </a>

    <!-- Hamburger Button -->
    <button id="menuToggle" class="flex flex-col gap-1.5 w-8 h-8 justify-center items-center p-1 hover:bg-gray-100 rounded transition-colors">
      <div class="w-full h-0.5 bg-slate-700 transition-all duration-300" id="bar1"></div>
      <div class="w-full h-0.5 bg-slate-700 transition-all duration-300" id="bar2"></div>
      <div class="w-full h-0.5 bg-slate-700 transition-all duration-300" id="bar3"></div>
    </button>
  </div>

  <!-- Mobile Menu -->
  <nav id="mobileMenu" class="hidden bg-white border-t border-gray-200">
    <ul class="py-2">
      <li>
        <a href={`${base}`} class="block py-4 px-6 text-slate-700 hover:bg-primary/10 hover:text-primary transition-colors font-semibold">
        Home
      </a>
      <a href={`${base}about-us`} class="block py-4 px-6 text-slate-700 hover:bg-primary/10 hover:text-primary transition-colors font-semibold">
        About Us
      </a>
      <a href={`${base}services`} class="block py-4 px-6 text-slate-700 hover:bg-primary/10 hover:text-primary transition-colors font-semibold">
        Services
      </a>
      <a href={`${base}projects`} class="block py-4 px-6 text-slate-700 hover:bg-primary/10 hover:text-primary transition-colors font-semibold">
        Projects
      </a>
      <a href={`${base}what-to-expect`} class="block py-4 px-6 text-slate-700 hover:bg-primary/10 hover:text-primary transition-colors font-semibold">
        What to Expect
      </a>
      <a href={`${base}faq`} class="block py-4 px-6 text-slate-700 hover:bg-primary/10 hover:text-primary transition-colors font-semibold">
        FAQ
      </a>
      <a href={`${base}register`} class="block py-4 px-6 bg-primary text-white hover:bg-primary-dark transition-colors font-bold">
        Register Now
      </a>
      </li>
    </ul>
  </nav>
</div>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    bar1?.classList.toggle('rotate-45');
    bar1?.classList.toggle('translate-y-2');
    bar2?.classList.toggle('opacity-0');
    bar3?.classList.toggle('-rotate-45');
    bar3?.classList.toggle('-translate-y-2');
  });
</script>
